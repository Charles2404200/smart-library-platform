# MySQL / PostgreSQL connection string for Prisma
DATABASE_URL=
MYSQL_SSL_CA=./ca.pem


# MongoDB connection string
MONGODB_URI=

# Backend Port
PORT=4000

# Optional: JWT secret if you use auth
JWT_SECRET="your_super_secret_jwt_key"

# Node environment
NODE_ENV=development

API_BASE="http://localhost:4000"
ADMIN_EMAIL="admin@library.com"
ADMIN_PASSWORD="admin123"



STAFF_EMAIL="staff@library.com"
STAFF_PASSWORD="staff123"

#Safe migrate
node db/run-sql.cjs

# Full reset (drops/recreates per your schema.sql):
node db/run-sql.cjs --reset
